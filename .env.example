# ==========================================
# VaultSwap - MTG Pod Trade & Buylist Binder
# ==========================================

# Flask session signing key (change in production!)
SECRET_KEY=vaultswap-dev-secret-key-change-in-production

# Web server port (defaults to 5055 locally, Cloud Run injects PORT=8080)
PORT=5055

# Neon Serverless PostgreSQL Connection Strings
# Direct connection (used for migrations / fallback if DATABASE_URL_POOLED is blank):
# Example: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Pooled PgBouncer connection (preferred at runtime when set):
# Example: postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=
# Neon Auth endpoint base URL (from Neon Console -> Auth):
NEON_AUTH_BASE_URL=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit base URL in production (e.g., https://vaultswap-xxx.run.app)
APP_BASE_URL=

# Allow quick pod-member switching / dev login without Google OAuth (set false in production)
DEV_LOGIN_ENABLED=true

# Admin & Invite-Only Access Control
ADMIN_EMAILS=jpmclaug@gmail.com
INVITE_ONLY=true

# Google Drive Picker Incremental Import
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
DRIVE_MAX_FILE_MB=500
DRIVE_IMPORT_CHUNK_ROWS=1000

# Mighty Meeple Light-Touch Caching & Rate-Limit Guard
MEEPLE_CACHE_TTL_HOURS=24
MEEPLE_RATE_LIMIT_MIN_SEC=1.5
MEEPLE_RATE_LIMIT_MAX_SEC=2.0

# Discord Webhook Notification Batching Delay (Default: 300s = 5 minutes)
DISCORD_WEBHOOK_DELAY_SEC=300

# Durable DB Job Queue & Cloud Tasks Dispatcher (for scale-to-zero on Cloud Run)
# Leave CLOUD_TASKS_QUEUE blank locally to use the in-process ThreadDispatcher.
CLOUD_TASKS_QUEUE=
TASKS_INVOKER_SA=
TASKS_SHARED_SECRET=
JOB_DISPATCHER=auto
